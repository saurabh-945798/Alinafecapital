NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_HOST/alinafe_capital?retryWrites=true&w=majority
MONGO_FALLBACK_HOSTS=
MONGO_FALLBACK_URI=
DNS_SERVERS=1.1.1.1,8.8.8.8
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_REFRESH_SECRET
JWT_REFRESH_EXPIRES_IN=7d
APP_BASE_URL=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
UPLOAD_DIR=/absolute/persistent/path/to/alinafe-uploads
MAX_UPLOAD_MB=6

# Bootstrap/admin scripts. Never commit real values.
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=REPLACE_WITH_ADMIN_EMAIL
SUPER_ADMIN_PHONE=REPLACE_WITH_E164_PHONE
SUPER_ADMIN_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_PASSWORD
ADMIN_PHONE=REPLACE_WITH_E164_PHONE
ADMIN_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_PASSWORD

# Mastercard Gateway / MPGS
MPGS_ENABLED=false
MPGS_GATEWAY_HOST=https://REPLACE_WITH_GATEWAY_HOST
MPGS_API_VERSION=100
MPGS_MERCHANT_ID=REPLACE_WITH_MERCHANT_ID
MPGS_API_PASSWORD=REPLACE_WITH_API_PASSWORD
MPGS_REPAYMENT_CURRENCY=MWK
MPGS_ORDER_ID_PREFIX=ACLR
MPGS_TRANSACTION_DESCRIPTION=Alinafe Capital loan repayment
MPGS_MIN_REPAYMENT_AMOUNT=1
MPGS_MAX_REPAYMENT_AMOUNT=0
MPGS_CHECKOUT_SCRIPT_URL=
MPGS_REQUEST_TIMEOUT_MS=30000

# Airtel Money
AIRTEL_ENABLED=false
AIRTEL_ENV=uat
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=REPLACE_WITH_CLIENT_ID
AIRTEL_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
AIRTEL_API_KEY=
AIRTEL_API_KEY_HEADER_NAME=X-API-Key
AIRTEL_WALLET_NUMBER=REPLACE_WITH_WALLET_NUMBER
AIRTEL_COUNTRY=MW
AIRTEL_CURRENCY=MWK
AIRTEL_MSISDN_FORMAT=national
AIRTEL_AUTH_PATH=/auth/oauth2/token
AIRTEL_COLLECTION_PATH=/merchant/v1/payments/
AIRTEL_STATUS_PATH=/standard/v1/payments
AIRTEL_TRANSACTION_PREFIX=ACLA
AIRTEL_MIN_REPAYMENT_AMOUNT=1
AIRTEL_MAX_REPAYMENT_AMOUNT=0
AIRTEL_REQUEST_TIMEOUT_MS=30000

# Authentication protection / customer password reset
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=15
LOGIN_ID_WINDOW_MINUTES=15
LOGIN_ID_MAX_ATTEMPTS=10
LOGIN_IP_MAX_ATTEMPTS=100
REGISTER_MAX_ATTEMPTS_PER_HOUR=10
PASSWORD_RESET_REQUEST_WINDOW_MINUTES=15
PASSWORD_RESET_REQUEST_MAX=5
PASSWORD_RESET_SUBMIT_MAX=10
PASSWORD_RESET_MINUTES=15
PASSWORD_RESET_BASE_URL=http://localhost:5173/reset-password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Alinafe Capital <no-reply@example.com>"
SESSION_IDLE_MINUTES=10
